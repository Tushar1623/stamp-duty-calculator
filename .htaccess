# ════════════════════════════════════════════════════════════
# 1. ENFORCE HTTPS & CANONICAL NON-WWW
# ════════════════════════════════════════════════════════════
RewriteEngine On
RewriteBase /

# Force HTTPS & non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://stampdutycalc.in/$1 [L,R=301]

# 301 Redirect /west-bengal or /west-bengal/ to canonical root /
RewriteRule ^west-bengal/?$ https://stampdutycalc.in/ [L,R=301]

# 410 Gone for Permanently Removed Jurisdictions (Chennai & Bengaluru)
RewriteRule ^(chennai|bangalore)(/.*)?$ - [G,L,NC]

# Ensure trailing slash on directory URLs (e.g., /maharashtra -> /maharashtra/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://stampdutycalc.in/$1/ [L,R=301]

# ════════════════════════════════════════════════════════════
# 2. SECURITY & ACCESS RESTRICTIONS (HOSTINGER SAFEGUARD)
# ════════════════════════════════════════════════════════════
# Prevent directory listing
Options -Indexes

# Block public access to sensitive development, test, and config files
RewriteRule ^tests(/.*)?$ - [F,L,NC]
RewriteRule ^\.git - [F,L,NC]
RewriteRule ^(package\.json|package-lock\.json|server\.js)$ - [F,L,NC]
RewriteRule \.(md|bak|log|sh)$ - [F,L,NC]

# Security Headers
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ════════════════════════════════════════════════════════════
# 3. ENABLE GZIP / BROTLI COMPRESSION
# ════════════════════════════════════════════════════════════
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml+rss
</IfModule>

# ════════════════════════════════════════════════════════════
# 4. LEVERAGE BROWSER CACHING
# ════════════════════════════════════════════════════════════
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Cache CSS and JavaScript for 1 month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    
    # Cache Images and Icons for 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    
    # Web manifest & fonts
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # Default cache fallback
    ExpiresDefault "access plus 2 days"
</IfModule>